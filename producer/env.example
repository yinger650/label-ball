# 复制为 producer/.env 或 export 后再跑 submit.sh / make_packets.py
# 不要把填好密钥的文件提交进 git。

# --- 数据与对象存储 ---
BALL_GT_DATA_ROOT=/mnt/afs/wangmin/data
BALL_GT_ACTIVITY_CACHE=/mnt/afs/wangmin/data/_research_ball_det/ball_gt/activity
BALL_GT_EXISTING_GT=/mnt/afs/wangmin/data/_research_ball_det/tbd/ball_gt
BALL_GT_COLLECT_DIR=/mnt/afs/wangmin/data/_research_ball_det/ball_gt/collected
BALL_GT_CREDENTIALS=/path/to/credentials.json
# 也可直接用开发机 /mnt/afs/wangmin/aoss.conf 的 tetrasvideo section

# --- 公网标注站包镜像 ---
BALL_GT_SYNC_DEST=root@yinger650.com:/var/lib/ball_gt_packets/

# --- SenseCore 产包任务 ---
BALL_GT_PARTITION=wm-team-4090
BALL_GT_WORKSPACE=wm-team-workspace
BALL_GT_RESOURCE=N10lP.nn.A80a.16c64g
BALL_GT_CONTAINER_IMAGE=registry.cn-sh-01.sensecore.cn/tetrasvideo/yinger650-ubuntu22-pt210-py310-cuda12:20260203-15h58m15s
BALL_GT_CONTAINER_MOUNTS=c110d384-191f-11f0-b28f-7ea3ea26affc:/mnt/afs
BALL_GT_JOB_NAME=ball_gt_produce

# ACP REST（默认提交路径）
ACP_CLI=$HOME/.cursor/skills/acp-api/scripts/acp_cli.py
ACP_ENV_FILE=/mnt/afs/wangmin/.env
